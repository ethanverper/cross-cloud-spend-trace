# Secrets — never committed.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# uv workspace member build artifacts
collectors/*/build/
collectors/*/dist/

# Landed raw data — real (if small-scale) usage data from live accounts,
# regenerated by running the collectors, not something to version.
data/raw/*
!data/raw/.gitkeep

# Phase 3 pipeline output — regenerated by running
# `python -m cross_cloud_spend_trace_analytics.pipeline` against data/raw/, not
# something to version (same reasoning as data/raw/ above).
data/processed/*
!data/processed/.gitkeep

# OS
.DS_Store
