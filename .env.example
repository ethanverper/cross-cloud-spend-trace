# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Every credential here is scoped to a dedicated, least-privilege
# read-only user/role Ethan created directly in each console (see
# docs/roadmap.md's Phase 1 entry). No agent has ever seen these values;
# they're handed to `developer` out-of-band, not through any AI assistant.

# --- AWS (spend-lens-collector IAM user) ---
# Read-only: ce:GetCostAndUsage, ce:GetCostForecast, ce:GetDimensionValues
# (plus scoped S3/Lambda access this collector never uses).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Snowflake (SPEND_LENS_SVC user / SPEND_LENS_READER role) ---
# SNOWFLAKE_ACCOUNT is the account identifier from your Snowsight URL,
# e.g. "xy12345.us-east-1" (not the full https:// URL).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SPEND_LENS_SVC
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SPEND_LENS_READER
SNOWFLAKE_WAREHOUSE=SPEND_LENS_WH

# --- Databricks (personal access token scoped to the trial workspace) ---
# DATABRICKS_HOST is the workspace URL, e.g. "https://dbc-xxxxxxxx-xxxx.cloud.databricks.com".
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Raw store ---
# Local (non-Docker) runs default to ./data/raw. Docker Compose overrides
# this to the bind-mounted /data/raw inside each container — no need to set
# it here unless running a collector outside Docker with a custom path.
# RAW_DATA_DIR=./data/raw
